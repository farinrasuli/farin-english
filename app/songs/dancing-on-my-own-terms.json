one,","fb":1},{"t0":63.8,"t1":67.6,"sec":"Build","text":"More with the polish and affection.","w":[[63.84,64.3],[64.3,64.86],[64.86,65.14],[65.14,65.81],[65.81,66.2],[66.2,66.78]]},{"t0":67.6,"t1":72,"sec":"Vocalise","text":"Ooh, ooh, ooh","fb":1},{"t0":72,"t1":77,"sec":"Vocalise","text":"Ooh, ooh, ooh","fb":1},{"t0":83.5,"t1":87.5,"sec":"Vocalise","text":"Da-da-da-da-da-da","fb":1},{"t0":87.5,"t1":97,"sec":"Vocalise","text":"Mmm","fb":1}],"gloss":[{"w":"self-respect","m":{"en":"the feeling that you are a good person and deserve to be treated well","tr":"öz saygı","fa":"عزت نفس","es":"respeto por uno mismo, amor propio"},"at":[[0,"self-respect"]]},{"w":"starting over","m":{"en":"beginning again from the start, often after something went wrong","tr":"yeniden başlamak, sıfırdan başlamak","fa":"از نو شروع کردن","es":"empezar de nuevo"},"at":[[0,"starting over"]]},{"w":"joyful","m":{"en":"very happy","tr":"neşeli, sevinç dolu","fa":"شاد، پر از شادی","es":"alegre"},"at":[[5,"joyful"]]},{"w":"permission","m":{"en":"when someone says that you can do something","tr":"izin","fa":"اجازه","es":"permiso"},"at":[[10,"permission"]]},{"w":"confident","m":{"en":"sure about yourself and what you can do","tr":"kendinden emin","fa":"با اعتمادبه‌نفس","es":"seguro de sí mismo"},"at":[[14,"confident"]]},{"w":"liberating","m":{"en":"making you feel free","tr":"özgürleştirici","fa":"رهایی‌بخش؛ بهت حسِ آزادی می‌ده","es":"liberador"},"at":[[14,"liberating"]]}]}