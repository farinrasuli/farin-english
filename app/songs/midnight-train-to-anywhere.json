{"id":"midnight-train-to-anywhere","v":1,"lines":[{"t0":18.06,"t1":20.26,"sec":"Verse 1","text":"There's a ticket in my pocket,","w":[[18.06,18.7],[18.7,18.78],[18.78,19.06],[19.06,19.36],[19.36,19.66],[19.66,20.24]]},{"t0":20.26,"t1":25.22,"sec":"Verse 1","text":"There's a storm outside the door.","w":[[20.26,21.86],[21.86,21.92],[21.92,22.46],[22.46,23.2],[23.2,23.56],[23.56,24.02]]},{"t0":26.62,"t1":30.28,"sec":"Verse 1","text":"I've been standing in this same old place","w":[[26.62,27.02],[27.02,27.1],[27.1,27.9],[27.9,28.14],[28.14,28.54],[28.54,28.94],[28.94,29.26],[29.26,29.88]]},{"t0":30.28,"t1":34.04,"sec":"Verse 1","text":"For longer than before.","w":[[30.28,30.6],[30.6,31.16],[31.16,31.68],[31.68,32.84]]},{"t0":35.82,"t1":37.44,"sec":"Verse 1","text":"The station clock is ticking,","w":[[35.82,36.14],[36.14,36.62],[36.62,37.04],[37.04,37.32],[37.32,37.57]]},{"t0":37.44,"t1":43.06,"sec":"Verse 1","text":"The last train's running late.","w":[[37.44,37.76],[37.76,39.6],[39.6,40.38],[40.38,41.16],[41.16,41.86]]},{"t0":44.08,"t1":48.12,"sec":"Verse 1","text":"I've got nothing left to lose tonight,","w":[[44.08,44.48],[44.48,44.68],[44.68,45.12],[45.12,45.46],[45.46,45.68],[45.68,46.4],[46.4,47.26]]},{"t0":48.12,"t1":51.28,"sec":"Verse 1","text":"And nothing left to wait.","w":[[48.12,48.44],[48.44,48.54],[48.54,49.18],[49.18,49.5],[49.5,50.08]]},{"t0":53.1,"t1":57.46,"sec":"Pre-Chorus","text":"Let the wheels roll, let the night unfold,","w":[[53.1,53.18],[53.18,53.32],[53.32,53.7],[53.7,55.32],[55.32,55.4],[55.4,55.5],[55.5,55.98],[55.98,56.81]]},{"t0":57.46,"t1":61.44,"sec":"Pre-Chorus","text":"There's a thousand stories down this road.","w":[[57.46,57.62],[57.62,57.7],[57.7,58.48],[58.48,59.12],[59.12,59.52],[59.52,59.92],[59.92,60.54]]},{"t0":61.44,"t1":66.18,"sec":"Chorus","text":"Take me on the midnight train to anywhere,","w":[[61.44,61.84],[61.84,62.12],[62.12,62.36],[62.36,62.56],[62.56,62.94],[62.94,63.8],[63.8,64.04],[64.04,65.08]]},{"t0":66.18,"t1"